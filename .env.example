PORT=5000
NODE_ENV=development
# Always include a database name in the path — Atlas SRV strings without one
# connect to the `test` database, which may be shared with other projects.
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/lifevault?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lifevault
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Optional comma-separated extra origins for CORS (e.g. a preview deploy)
EXTRA_ORIGINS=

# Google OAuth — optional. Leave empty to disable Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

