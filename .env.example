PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lifevault
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Optional comma-separated extra origins for CORS (e.g. a preview deploy)
EXTRA_ORIGINS=

# Cloudinary — required for uploads to work in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
